{
  "name": "salao-backend",
  "version": "1.0.0",
  "description": "Backend local para Sistema de Gestão de Salão de Beleza e Estética",
  "main": "server.js",
  "scripts": {
    "start": "concurrently -k \"node server-whatsapp.js\" \"node server.js\"",
    "dev": "concurrently -k \"node server-whatsapp.js\" \"node --watch server.js\"",
    "whatsapp": "node server-whatsapp.js",
    "server": "node server.js",
    "test": "node tests/run_tests.js",
    "test:ui": "node tests/interface_flows_test.js",
    "test:stress": "node tests/stress_tests.js",
    "test:all": "node tests/run_tests.js && node tests/stress_tests.js && node tests/interface_flows_test.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "archiver": "^7.0.1",
    "concurrently": "^10.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7"
  }
}
