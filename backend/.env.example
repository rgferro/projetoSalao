# Configurações do Sistema BellaGestão Studio
PORT=3001
WHATSAPP_PORT=3005
APP_URL=https://belagestaostudio.com.br
JWT_SECRET=bellagestao_jwt_secret_super_seguro_2026

# Configurações do Brevo (Envio de E-mails Transacionais e Códigos)
# Obtenha sua API Key em: Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new API key (v3)
BREVO_API_KEY=xkeysib-sua-chave-api-aqui
BREVO_SENDER_NAME="BellaGestão Studio"
# O e-mail do remetente DEVE pertencer a um dos domínios autenticados no Brevo (ex: belagestaostudio.com.br)
BREVO_SENDER_EMAIL=contato@belagestaostudio.com.br

# Configurações do Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxx-xxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxxxx-xxxxxx
